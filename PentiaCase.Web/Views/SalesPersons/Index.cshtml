@model List<PentiaCase.Web.ViewModels.SalesPersonListItemViewModel>

@{
    ViewData["Title"] = "Salespeople";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1>Salespeople</h1>
        <p class="text-muted">
            Overview of all salespeople and their orders.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                Salespeople (@Model.Count)
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Orders</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in Model)
                        {
                            <tr>
                                <td class="ps-4 align-middle">
                                    @person.Name
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-primary">
                                        @person.OrderCount
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="SalesPersons"
                                       asp-action="Details"
                                       asp-route-id="@person.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View details
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted py-4">
                                    No salespeople found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
